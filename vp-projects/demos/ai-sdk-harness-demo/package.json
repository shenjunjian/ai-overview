{
  "name": "ai-sdk-harness-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HarnessAgent + DeepSeek console coding agent with a local-folder sandbox, skills and mocked host tools.",
  "scripts": {
    "start": "tsx src/index.ts",
    "demo": "tsx src/index.ts --folder ./workspace",
    "oneshot": "tsx src/index.ts --folder ./workspace --prompt \"Create a small Node.js CLI that prints a greeting\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.75",
    "@ai-sdk/harness": "1.0.167",
    "@ai-sdk/provider": "4.0.34",
    "@ai-sdk/provider-utils": "5.0.70",
    "@ai-sdk/sandbox-just-bash": "1.0.167",
    "ai": "7.0.156",
    "just-bash": "^2.14.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.10.1"
}